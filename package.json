{
  "name": "turbopick",
  "displayName": "TurboPick",
  "description": "Fuzzy search for vscode.",
  "publisher": "lucatung",
  "version": "0.1.1",
  "homepage": "https://github.com/lucatung/turbopick",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucatung/turbopick.git"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "turbo_pick_icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "turbopick.searchFiles",
        "title": "TurboPick: Search Files"
      },
      {
        "command": "turbopick.searchDocumentSymbols",
        "title": "TurboPick: Search Document Symbols"
      },
      {
        "command": "turbopick.searchWorkspaceSymbols",
        "title": "TurboPick: Search Workspace Symbols"
      },
      {
        "command": "turbopick.searchLines",
        "title": "TurboPick: Search Lines"
      },
      {
        "command": "turbopick.searchWorkspaceLines",
        "title": "TurboPick: Search Workspace Lines"
      }
    ],
    "configuration": {
      "title": "TurboPick",
      "properties": {
        "turbopick.preview": {
          "type": "boolean",
          "default": true,
          "description": "Enable preview when searching document symbols."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:wasm": "zig build-exe src/zig/algo.zig -target wasm32-freestanding -O ReleaseSmall -fno-entry -rdynamic -femit-bin=dist/algo.wasm",
    "test:zig": "zig test src/zig/algo.zig -O Debug",
    "compile": "npm run build:wasm && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:wasm && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run test:zig",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}