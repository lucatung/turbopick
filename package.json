{
  "name": "turbopick",
  "displayName": "TurboPick",
  "description": "Fuzzy search for vscode.",
  "publisher": "lucatung",
  "version": "0.2.0",
  "homepage": "https://github.com/lucatung/turbopick",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucatung/turbopick.git"
  },
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "turbo_pick_icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "turbopick.searchFiles",
        "title": "TurboPick: Search Files"
      },
      {
        "command": "turbopick.searchDocumentSymbols",
        "title": "TurboPick: Search Document Symbols"
      },
      {
        "command": "turbopick.searchWorkspaceSymbols",
        "title": "TurboPick: Search Workspace Symbols"
      },
      {
        "command": "turbopick.searchLines",
        "title": "TurboPick: Search Lines"
      },
      {
        "command": "turbopick.searchWorkspaceLines",
        "title": "TurboPick: Search Workspace Lines"
      }
    ],
    "configuration": {
      "title": "TurboPick",
      "properties": {
        "turbopick.preview": {
          "type": "boolean",
          "default": true,
          "description": "Enable preview when searching document symbols."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:wasm": "node scripts/build-wasm.ts",
    "test:algo": "cargo test --manifest-path src/rust/Cargo.toml",
    "compile": "npm run build:wasm && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:wasm && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run test:algo",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsce": "vsce"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}